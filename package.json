{
  "name": "day-12-collaborative-workspace",
  "version": "1.0.0",
  "description": "Real-Time Collaborative Code and Whiteboard Workspace with Yjs CRDTs, Monaco Editor, Canvas Whiteboard, and Sandboxed Code Runner",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild client/app.js --bundle --minify --sourcemap --outfile=public/bundle.js --format=esm",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "crdt",
    "yjs",
    "collaborative-editor",
    "monaco-editor",
    "whiteboard",
    "websockets",
    "sandbox"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "monaco-editor": "^0.57.0",
    "ws": "^8.18.0",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.23"
  }
}
